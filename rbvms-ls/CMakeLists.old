#-------------------------------------------------------------------------------
# Add Files
#-------------------------------------------------------------------------------
set(SOURCES
    formulation.cpp
    integrator.cpp
    dist_solver.cpp)

set(HEADERS
    formulation.hpp
    integrator.hpp
    dist_solver.hpp)

#-------------------------------------------------------------------------------
# Build executable
#-------------------------------------------------------------------------------
include_directories(../util)

if (MFEM_USE_CUDA)
   enable_language(CUDA)
   set_source_files_properties(${SOURCES} PROPERTIES LANGUAGE CUDA)
endif()

add_executable(rbvms-ls rbvms-ls.cpp ${SOURCES} ${HEADERS})
target_link_libraries(rbvms-ls PRIVATE ${LIBRARIES} util ${CMAKE_DL_LIBS})
install(TARGETS rbvms-ls DESTINATION bin)

add_executable(supg-ls supg-ls.cpp ${SOURCES} ${HEADERS})
target_link_libraries(supg-ls PRIVATE ${LIBRARIES} util ${CMAKE_DL_LIBS})
install(TARGETS supg-ls DESTINATION bin)
